rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profile document. The backend-managed retention field expireAt
    // (ADR-0007) is never client-writable: a coerced device must not be
    // able to stretch or shrink the retention promise. Client deletes are
    // refused because deletion goes through the backend single deletion
    // path (panic_wipe), which cascades to subcollections; a client-side
    // document delete would orphan them.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['expireAt']);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['expireAt']);
      allow delete: if false;
    }

    // Walking-skeleton notes.
    match /users/{uid}/notes/{noteId} {
      allow read, write: if isOwner(uid);
    }

    // v6 conversation sessions (ADR-0003): written only by the backend via
    // the Admin SDK (which bypasses rules), so a coerced device can never
    // alter session state or clear a safety flag from the client. The owner
    // may read their own transcript; deletion goes through the backend
    // (panic_wipe is a nonce-gated endpoint and must cascade to events),
    // never a client-side document delete.
    match /users/{uid}/sessions/{sessionId} {
      allow read: if isOwner(uid);
      allow write: if false;
      match /events/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ADK user-scoped state (`user:` keys), kept off the session document.
    // Backend-written only, owner-readable. App-scoped state (`app:` keys)
    // lives in the top-level adkAppState collection, which has no match
    // block and is therefore denied to all clients by default.
    match /users/{uid}/adkUserState/{appName} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Crisis sessions: every create/update must carry an expireAt timestamp
    // so the Firestore TTL policy can auto-delete the transcript (48-72h).
    match /users/{uid}/crisisSessions/{sessionId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.expireAt is timestamp;
      match /messages/{msgId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Everything else is denied by default (no match = no access).
  }
}
