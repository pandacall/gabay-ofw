rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profile document.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Walking-skeleton notes.
    match /users/{uid}/notes/{noteId} {
      allow read, write: if isOwner(uid);
    }

    // Crisis sessions: every create/update must carry an expireAt timestamp
    // so the Firestore TTL policy can auto-delete the transcript (48-72h).
    match /users/{uid}/crisisSessions/{sessionId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.expireAt is timestamp;
      match /messages/{msgId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Everything else is denied by default (no match = no access).
  }
}
